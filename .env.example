# Optional. Copy to .env and edit. Everything here ends up in the browser bundle,
# so never put private keys or secret API keys in this file.

# RPC overrides, one per chain id (public defaults are built in)
VITE_RPC_1=https://ethereum-rpc.publicnode.com
VITE_RPC_8453=https://mainnet.base.org
VITE_RPC_42161=https://arb1.arbitrum.io/rpc
VITE_RPC_137=https://polygon-bor-rpc.publicnode.com
VITE_RPC_56=https://bsc-dataseed.binance.org
VITE_RPC_46630=https://rpc.testnet.chain.robinhood.com
VITE_RPC_84532=https://sepolia.base.org
VITE_RPC_11155111=https://ethereum-sepolia-rpc.publicnode.com

# Optional Etherscan V2 API key. Used only to auto-load contract ABIs
# (works for Ethereum, Base, Arbitrum, Polygon, BNB and their testnets).
VITE_EXPLORER_API_KEY=
